# Cardinal — proxy/choke point as a Coraza WAF (OWASP CRS) in front of the app.
#
# Request path:  edge-net -> proxy here -> [Coraza + OWASP CRS] -> webapp:5000
# The WAF inspects the raw HTTP request (URL, params, headers, body) and scores
# it with CRS. It only ever sees the request on the wire, never the final SQL
# the app builds -- which is exactly the blind spot the structural / second-order
# bypasses aim at.
#
# Two ports, so before/after needs no reload (coraza compiles its ruleset once,
# and Kathara copies these configs in at start, so a live toggle is unreliable):
#   :80    ENFORCING  (SecRuleEngine On)            -> blocks attacks. The choke point.
#   :8080  DETECTION  (SecRuleEngine DetectionOnly) -> logs but forwards. "Before the WAF" baseline.
# Both reverse-proxy to the same webapp. ./expose-ui.sh publishes :80 to the host.

{
	# No TLS in the lab: serve plain HTTP and never reach out to an ACME server
	# (which would fail in the isolated lab and spam the log).
	auto_https off
	admin localhost:2019
	# coraza_waf must run before reverse_proxy so a blocked request never reaches
	# the backend.
	order coraza_waf first
	log {
		output stdout
		format console
	}
}

# --- :80 — enforcing WAF (the real choke point) ---
:80 {
	coraza_waf {
		directives `
		Include /etc/coraza/coraza.conf
		Include /etc/coraza/crs/crs-setup.conf
		Include /etc/coraza/crs/rules/*.conf
		Include /etc/coraza/mode-enforce.conf
		`
	}
	reverse_proxy 172.31.0.20:5000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	# A blocked request otherwise returns a bare, empty 403 that renders as a
	# BLANK PAGE in a browser -- easily mistaken for the app crashing. Serve an
	# explanatory page instead so it is obvious the WAF stopped the request, and
	# point at the detection endpoint for anyone who wants to watch what the app
	# would have done with it.
	handle_errors {
		@blocked expression {err.status_code} == 403
		respond @blocked `<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Blocked by WAF — Cardinal</title>
<style>
  body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0f1115;
       color:#e7e9ee;font:15px/1.6 -apple-system,Segoe UI,Roboto,sans-serif}
  .card{max-width:560px;margin:24px;padding:28px 30px;background:#171a21;
        border:1px solid #2a2f3a;border-radius:14px}
  .code{font-size:40px;font-weight:800;color:#ff5d5d;letter-spacing:.5px}
  h1{font-size:19px;margin:.3em 0 .6em}
  p{margin:.5em 0;color:#c3c8d2} .muted{color:#8b93a1;font-size:13.5px}
  code{background:#0f1115;border:1px solid #2a2f3a;border-radius:6px;padding:1px 6px}
  b{color:#e7e9ee}
</style></head>
<body>
  <div class="card">
    <div class="code">403</div>
    <h1>Request blocked by the WAF</h1>
    <p>This request matched an <b>OWASP Core Rule Set</b> signature (e.g. a
       SQL-injection pattern) and was stopped by the <b>Coraza</b> WAF at the
       proxy. It never reached the application.</p>
    <p class="muted">You are on the <b>enforcing</b> endpoint (proxy&nbsp;:80).
       To watch what the application <i>would</i> have done with this request —
       including the exact SQL it runs — use the <b>detection</b> endpoint at
       <code>http://localhost:8081</code>, which logs the request but forwards it.</p>
  </div>
</body></html>` 403
	}
}

# --- :8080 — detection-only baseline (attack succeeds, but is logged) ---
:8080 {
	coraza_waf {
		directives `
		Include /etc/coraza/coraza.conf
		Include /etc/coraza/crs/crs-setup.conf
		Include /etc/coraza/crs/rules/*.conf
		Include /etc/coraza/mode-detect.conf
		`
	}
	reverse_proxy 172.31.0.20:5000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
