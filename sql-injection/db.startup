#!/bin/bash
# db — MariaDB on app-net (eth0).
#
# Kathara does NOT run the official mariadb entrypoint, so we initialise the
# data directory, start the server, and import the seed by hand. Each `kathara
# lstart` is a fresh container (empty /var/lib/mysql), so this seeds cleanly
# every time — `lclean` -> `lstart` reproduces a known state.
ip addr add 172.31.0.30/24 dev eth0
ip link set eth0 up

DATADIR=/var/lib/mysql

if [ ! -d "$DATADIR/mysql" ]; then
    echo "[*] db: initialising data directory..."
    mariadb-install-db --user=mysql --datadir="$DATADIR" --auth-root-authentication-method=normal >/dev/null
fi

# The general query log is the SQLi "structural cut": every statement AS THE
# DATABASE RECEIVED IT. It goes to the Kathara shared dir (/shared is mounted
# into every node, host-backed) so the passive monitor can read it without
# opening a connection to the DB. mysqld must be able to write there.
mkdir -p /shared && chmod 777 /shared

echo "[*] db: starting mariadbd (general query log -> /shared/db_query.log)..."
mariadbd --user=mysql --bind-address=0.0.0.0 \
    --general-log=1 --general-log-file=/shared/db_query.log --log-output=FILE &
DB_PID=$!

# Wait for the server to accept connections over the local socket.
echo "[*] db: waiting for server..."
for i in $(seq 1 30); do
    if mariadb-admin ping >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

echo "[*] db: importing seed..."
mariadb < /seed.sql

# OOB scenario: register the loadable oob_dns UDF so an
# injected SELECT can make the DB leak a value over DNS.
echo "[*] db: registering OOB UDF (oob_dns)..."
mariadb < /oob-setup.sql

# Egress-control toggle scripts Kathara's file
# mount drops the executable bit, so restore it (mirrors attacker/monitor).
chmod +x /usr/local/bin/egress-lock /usr/local/bin/egress-unlock 2>/dev/null

echo "[*] db: ready (portal database seeded; OOB UDF loaded, egress OPEN)."
# Keep the container alive on the server process.
wait "$DB_PID"
